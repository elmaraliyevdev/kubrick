# Backend API base URL (axios `baseURL`). Must be the origin that issues auth cookies + `/api` prefix.
# Use the same host you use in the browser for the API (e.g. `localhost` vs `127.0.0.1` are different cookie jars).
# Credentialed requests + cookies: CSRF / SameSite notes — see docs/CSRF-and-auth.md
VITE_API_URL=http://localhost:8000/api
