# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/kubrick

# Email Service (Resend)
RESEND_API_KEY=your_resend_api_key_here
FROM_EMAIL=Kubrick <noreply@kubrick.app>
# Public API origin for tracking pixels in outbound HTML (no trailing slash), e.g. http://localhost:8000
PUBLIC_API_URL=http://localhost:8000
# Optional: append ?secret=... to the Resend webhook URL and set the same value here
RESEND_WEBHOOK_SECRET=

# Security Configuration
SECRET_KEY=generate_a_secure_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# OpenAI Configuration for Resume Parsing
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_TEMPERATURE=0.1
OPENAI_MAX_TOKENS=2000
OPENAI_TIMEOUT=30
OPENAI_RETRY_ATTEMPTS=3

# Resume Parser Configuration
RESUME_PARSER_STRATEGY=llm_with_fallback

# Environment
ENVIRONMENT=development
DEBUG=true
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Auth cookies (must match how the browser calls the API — see frontend VITE_API_URL)
# CSRF: SameSite+Lax is often enough when SPA+API are same-site; cross-site or SameSite=None needs extra defenses.
# See docs/CSRF-and-auth.md
# Optional: set to share cookies across subdomains, e.g. `.kubrick.app` for `app.` + `api.`
# AUTH_COOKIE_DOMAIN=
# lax (default) | strict | none — use `none` only if SPA and API are truly cross-site and you need credentialed XHR; requires HTTPS
# AUTH_COOKIE_SAMESITE=lax

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=100/minute
# Optional shared store for OTP send rate limits (recommended in production)
# Example: redis://localhost:6379/0
REDIS_URL=

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json