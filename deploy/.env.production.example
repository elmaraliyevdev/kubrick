# Kubrick — Production environment variables
# Copy to /home/kubrick/kubrick/backend/.env on the EC2 instance

DATABASE_URL=postgresql://kubrick_prod:YOUR_DB_PASSWORD@localhost:5432/kubrick_prod

RESEND_API_KEY=re_your_production_key
FROM_EMAIL=Kubrick <noreply@kubrick.app>

SECRET_KEY=GENERATE_WITH_python3_-c_"import secrets; print(secrets.token_urlsafe(64))"
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

OPENAI_API_KEY=sk-your-production-key
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_TEMPERATURE=0.1
OPENAI_MAX_TOKENS=2000
OPENAI_TIMEOUT=30

RESUME_PARSER_STRATEGY=llm_with_fallback

ENVIRONMENT=production
DEBUG=false
ALLOWED_ORIGINS=https://app.kubrick.app,https://kubrick.app
