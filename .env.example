# =============================================================================
# Kubrick Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# For production, use a secrets manager (AWS Secrets Manager, Vault, etc.)
# =============================================================================

# --- Database ---
DATABASE_URL=postgresql://kubrick_user:your_password@localhost:5432/kubrick

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Backend ---
# CRITICAL: Generate a cryptographically secure key for production
# Run: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_GENERATE_WITH_SECRETS_MODULE
ENVIRONMENT=production
DEBUG=false
# In production, use HTTPS origins only
ALLOWED_ORIGINS=https://your-domain.com

# --- Email Service (Postmark) ---
# Required for authentication (OTP codes)
# Get your API key from: https://postmarkapp.com/
POSTMARK_API_KEY=your_postmark_api_key_here
POSTMARK_FROM_EMAIL=no-reply@your-domain.com
POSTMARK_OTP_TEMPLATE_ID=your_template_id

# --- OpenAI (Resume Parsing) ---
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_TEMPERATURE=0.1
OPENAI_MAX_TOKENS=2000
OPENAI_TIMEOUT=30

# --- Resume Parser ---
RESUME_PARSER_STRATEGY=llm_with_fallback

# --- Rate Limiting ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=100/minute

# --- Logging ---
LOG_LEVEL=WARNING
LOG_FORMAT=json

# --- Frontend ---
VITE_API_URL=/api
